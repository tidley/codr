+        assert!(addressed_accounts(&[]).is_empty());
+        assert!(
+            addressed_accounts(&[vec!["text".into(), format!("@{}", "aa".repeat(32))]]).is_empty()
+        );
+        assert_eq!(
+            addressed_accounts(&[
+                vec!["p".into(), "AA".repeat(32)],
+                vec!["p".into(), "aa".repeat(32)]
+            ]),
+            vec!["aa".repeat(32)]
+        );
+    }
+}
